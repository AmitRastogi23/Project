<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Faculties</title>
    <link rel="stylesheet" href="/css/faculty/show.css" />
  </head>
  <body>
    <div class="container">
      <!-- ═════════ Page Header ═════════ -->
      <header class="page-header">
        <div class="page-header-text">
          <h1>All Faculties</h1>
          <p class="subtitle">
            <span id="totalCount">0</span> records across
            <span id="totalOrgs">0</span> organizations
          </p>
        </div>

        <button class="add-faculty-btn" id="openAddModal">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Add Faculty
        </button>
      </header>

      <!-- ═════════ Filter Pills ═════════ -->
      <div class="filter-bar" id="filterBar" style="display: none">
        <!-- JS will fill this -->
      </div>

      <!-- ═════════ Faculty Table ═════════ -->
      <div id="tableContainer" style="display: none">
        <div class="table-card">
          <table class="faculty-table">
            <thead>
              <tr>
                <th class="col-sno">S.No</th>
                <th class="col-name">Name</th>
                <th class="col-rank">Rank</th>
                <th class="col-org">Organization</th>
                <th class="col-email">Email</th>
                <th class="col-phone">Phone</th>
                <th class="col-address">Address</th>
                <th class="col-guest">Guest</th>
                <th class="col-retd">Retired</th>
                <th class="col-action"></th>
              </tr>
            </thead>
            <tbody id="facultyBody">
              <!-- JS will fill this -->
            </tbody>
          </table>
        </div>

        <div class="empty-state" id="filterEmpty" style="display: none">
          <h2>No faculties found</h2>
          <p>No records for this organization.</p>
        </div>
      </div>

      <!-- Loading / Empty State -->
      <div class="empty-state" id="loadingState">
        <h2>Loading...</h2>
        <p>Fetching faculty records.</p>
      </div>

      <div class="empty-state" id="noDataState" style="display: none">
        <h2>No faculties yet</h2>
        <p>Click "Add Faculty" to add your first record.</p>
      </div>
    </div>

    <!-- ═════════ Delete Modal ═════════ -->
    <div class="modal-overlay" id="deleteModal">
      <div class="modal modal-confirm">
        <div class="modal-icon icon-danger">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
            ></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        </div>
        <h2 class="modal-title">Delete Faculty?</h2>
        <p class="modal-text">
          Are you sure you want to delete faculty record of
          <strong id="modalFacultyName">this faculty</strong>? This action
          cannot be undone.
        </p>
        <div class="modal-actions">
          <button class="btn btn-cancel" id="cancelDelete">Cancel</button>
          <button class="btn btn-danger" id="confirmDelete">Delete</button>
        </div>
      </div>
    </div>

    <!-- ═════════ Edit Modal ═════════ -->
    <div class="modal-overlay" id="editModal">
      <div class="modal modal-form">
        <div class="modal-header">
          <div>
            <h2 class="modal-title">Edit Faculty</h2>
            <p class="modal-subtitle">Update faculty information</p>
          </div>
          <button class="modal-close" id="closeEditModal" type="button">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <form id="editForm" class="edit-form">
          <input type="hidden" id="editId" />
          <div class="form-grid">
            <div class="form-row">
              <label for="editName">Name</label
              ><input type="text" id="editName" required />
            </div>
            <div class="form-row">
              <label for="editRank">Rank</label
              ><input type="text" id="editRank" />
            </div>
            <div class="form-row">
              <label for="editOrganization">Organization</label
              ><input type="text" id="editOrganization" />
            </div>
            <div class="form-row">
              <label for="editEmail">Email</label
              ><input type="email" id="editEmail" />
            </div>
            <div class="form-row">
              <label for="editPhone">Phone</label
              ><input type="tel" id="editPhone" />
            </div>
            <div class="form-row">
              <label for="editAddress">Address</label
              ><input type="text" id="editAddress" />
            </div>
          </div>
          <div class="toggle-row">
            <span class="toggle-label">Guest Faculty</span>
            <div class="radio-group">
              <label class="radio-option"
                ><input type="radio" name="editGuest" value="true" /><span
                  >Yes</span
                ></label
              >
              <label class="radio-option"
                ><input type="radio" name="editGuest" value="false" /><span
                  >No</span
                ></label
              >
            </div>
          </div>
          <div class="toggle-row">
            <span class="toggle-label">Retired</span>
            <div class="radio-group">
              <label class="radio-option"
                ><input type="radio" name="editRetired" value="true" /><span
                  >Yes</span
                ></label
              >
              <label class="radio-option"
                ><input type="radio" name="editRetired" value="false" /><span
                  >No</span
                ></label
              >
            </div>
          </div>
          <div class="modal-actions">
            <button type="button" class="btn btn-cancel" id="cancelEdit">
              Cancel
            </button>
            <button type="submit" class="btn btn-primary" id="saveEdit">
              Save Changes
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ═════════ Add Modal ═════════ -->
    <div class="modal-overlay" id="addModal">
      <div class="modal modal-form">
        <div class="modal-header">
          <div>
            <h2 class="modal-title">Add New Faculty</h2>
            <p class="modal-subtitle">Fill in the faculty details</p>
          </div>
          <button class="modal-close" id="closeAddModal" type="button">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <form id="addForm" class="edit-form">
          <div class="form-grid">
            <div class="form-row">
              <label for="addName">Name <span class="req">*</span></label
              ><input type="text" id="addName" required />
            </div>
            <div class="form-row">
              <label for="addRank">Rank</label
              ><input type="text" id="addRank" />
            </div>
            <div class="form-row">
              <label for="addOrganization">Organization</label
              ><input type="text" id="addOrganization" />
            </div>
            <div class="form-row">
              <label for="addEmail">Email</label
              ><input type="email" id="addEmail" />
            </div>
            <div class="form-row">
              <label for="addPhone">Phone</label
              ><input type="tel" id="addPhone" />
            </div>
            <div class="form-row">
              <label for="addAddress">Address</label
              ><input type="text" id="addAddress" />
            </div>
          </div>
          <div class="toggle-row">
            <span class="toggle-label">Guest Faculty</span>
            <div class="radio-group">
              <label class="radio-option"
                ><input type="radio" name="addGuest" value="true" /><span
                  >Yes</span
                ></label
              >
              <label class="radio-option"
                ><input
                  type="radio"
                  name="addGuest"
                  value="false"
                  checked
                /><span>No</span></label
              >
            </div>
          </div>
          <div class="toggle-row">
            <span class="toggle-label">Retired</span>
            <div class="radio-group">
              <label class="radio-option"
                ><input type="radio" name="addRetired" value="true" /><span
                  >Yes</span
                ></label
              >
              <label class="radio-option"
                ><input
                  type="radio"
                  name="addRetired"
                  value="false"
                  checked
                /><span>No</span></label
              >
            </div>
          </div>
          <div class="modal-actions">
            <button type="button" class="btn btn-cancel" id="cancelAdd">
              Cancel
            </button>
            <button type="submit" class="btn btn-primary" id="saveAdd">
              Add Faculty
            </button>
          </div>
        </form>
      </div>
    </div>

    <script src="/js/faculty/show.js"></script>
  </body>
</html>
