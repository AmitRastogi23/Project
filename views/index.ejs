<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SDC Pilkhuwa | Training Record Management System</title>

    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <div class="top-bar"></div>

    <header>
      <div class="brand">
        <img src="/images/cfees-logo.png" alt="CFEES Logo" />

        <div class="brand-text">
          <h1>SDC Pilkhuwa</h1>
          <h2>Training Record Management System</h2>
        </div>
      </div>

      <div class="organization">
        <strong>Centre for Fire, Explosive and Environment Safety</strong>
        <br />
        Defence Research and Development Organisation
        <br />
        Ministry of Defence, Government of India
      </div>
    </header>

    <main>
      <section class="welcome-section">
        <div class="welcome-content">
          <div class="welcome-label">SDC Pilkhuwa · Digital Records</div>

          <h1>Training Records Dashboard</h1>

          <p>
            Centralized digital management system for maintaining, searching,
            and managing training course and applicant records at SDC Pilkhuwa.
          </p>
        </div>
      </section>

      <div class="section-header">
        <h2 class="section-title">Record Management</h2>
        <p class="section-subtitle">Select an operation to continue</p>
      </div>

      <section class="options">
        <div class="card">
          <div>
            <div class="card-top">
              <div class="card-icon">📅</div>
              <div class="card-number">01</div>
            </div>

            <h2>Search by Year</h2>

            <p>
              Browse training courses conducted in a selected year and view the
              applicants enrolled in each course.
            </p>
          </div>

          <a href="/year" class="btn">
            <span>View Year-wise Records</span>
            <span>→</span>
          </a>
        </div>

        <div class="card">
          <div>
            <div class="card-top">
              <div class="card-icon">🔍</div>
              <div class="card-number">02</div>
            </div>

            <h2>Search by Course</h2>

            <p>
              Search for a training course using its course number or course
              name and access complete course records.
            </p>
          </div>

          <a href="/course" class="btn">
            <span>Search Course Records</span>
            <span>→</span>
          </a>
        </div>

        <div class="card">
          <div>
            <div class="card-top">
              <div class="card-icon">🔍</div>
              <div class="card-number">03</div>
            </div>

            <h2>Search Applicant</h2>

            <p>
              Search for a trainee using its personnel number and name and
              access complete trainee records.
            </p>
          </div>

          <a href="/applicant/search" class="btn">
            <span>Search Applicant Record</span>
            <span>→</span>
          </a>
        </div>

        <div class="card">
          <div>
            <div class="card-top">
              <div class="card-icon">➕</div>
              <div class="card-number">04</div>
            </div>

            <h2>Add New Course</h2>

            <p>
              Create a new training course and maintain its schedule, duration,
              and associated applicant records.
            </p>
          </div>

          <a href="/course/new" class="btn">
            <span>Create New Course</span>
            <span>→</span>
          </a>
        </div>

        <div class="card">
          <div>
            <div class="card-top">
              <div class="card-icon">📅</div>
              <div class="card-number">05</div>
            </div>

            <h2>Edit Authorities</h2>

            <p>Browse the saved authority records and update them.</p>
          </div>

          <a href="/signatory" class="btn">
            <span>Edit the Official Authority Record</span>
            <span>→</span>
          </a>
        </div>

        <div class="card">
          <div>
            <div class="card-top">
              <div class="card-icon">📅</div>
              <div class="card-number">06</div>
            </div>

            <h2>Faculty Details</h2>

            <p>Browse the saved faculty records and update them.</p>
          </div>

          <a href="/faculty" class="btn">
            <span>Edit the Official Faculty Record</span>
            <span>→</span>
          </a>
        </div>

        <div class="card">
          <div>
            <div class="card-top">
              <div class="card-icon">📅</div>
              <div class="card-number">07</div>
            </div>

            <h2>Addressee Details</h2>

            <p>Browse the saved Address records and update them.</p>
          </div>

          <a href="/address" class="btn">
            <span>Edit the Official Address Record</span>
            <span>→</span>
          </a>
        </div>
      </section>
    </main>

    <footer>
      <strong>SDC Pilkhuwa | CFEES, DRDO</strong>
      <br />
      Training Record Management System
    </footer>
  </body>
</html>
