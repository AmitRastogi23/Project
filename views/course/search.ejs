<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Search Course | SDC Pilkhuwa</title>
  <link rel="stylesheet" href="/css/course/search.css" />
</head>

<body>
  <div class="top-bar"></div>

  <header>
    <div class="brand">
      <img src="/images/cfees-logo.png" alt="CFEES Logo" />

      <div class="brand-text">
        <h1>SDC Pilkhuwa</h1>
        <h2>Training Record Management System</h2>
      </div>
    </div>

    <div class="organization">
      <strong>Centre for Fire, Explosive and Environment Safety</strong>
      <br />
      Defence Research and Development Organisation
      <br />
      Ministry of Defence, Government of India
    </div>
  </header>

  <main>
    <section class="page-header">
      <div class="page-header-content">
        <div class="page-label">Training Records · Search</div>
        <h1>Search Course</h1>
        <p>Enter the course details to access the complete training record.</p>
      </div>
    </section>

    <section class="search-card">
      <div class="search-card-header">
        <h2>Course Search</h2>
        <p>Enter both fields to locate the required course.</p>
      </div>

      <form action="/course/details" method="get">
        <div class="form-grid">
          <div class="form-group">
            <label for="courseNumber">Course Number</label>
            <input
              type="number"
              name="courseNumber"
              id="courseNumber"
              placeholder="e.g. 170"
              required
            />
          </div>

          <div class="form-group">
            <label for="courseName">Course Name</label>
            <input
              type="text"
              name="courseName"
              id="courseName"
              placeholder="Enter the complete course name"
              required
            />
          </div>
        </div>

        <div class="note">
          Enter the course number and course name exactly as recorded in the
          training records.
        </div>

        <div class="form-actions">
          <button type="submit">View Course Details</button>
        </div>
      </form>
    </section>
  </main>

  <footer>
    <strong>SDC Pilkhuwa | CFEES, DRDO</strong>
    <br />
    Training Record Management System
  </footer>
</body>
</html>